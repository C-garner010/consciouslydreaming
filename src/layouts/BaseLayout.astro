---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/responsive.css';
const { title, description = 'Reflections, fragments, and field notes from the edge of the unknown — where chaos meets curiosity.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Consciously Dreaming</title>
  </head>
  <body>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <script>import '../scripts/navigation.js';</script>
  </body>
</html>
