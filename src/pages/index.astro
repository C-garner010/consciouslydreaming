---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Home">
<section class="home-hero" aria-labelledby="home-title">
  <div class="container home-hero-content">
    <h1 id="home-title">Consciously Dreaming</h1>
    <h2>Reflections, fragments, and field notes from the edge of the unknown: where chaos meets curiosity.</h2>
    <p>An unfinished space for an exploratory mind. A collection of all I am, all I come across, consciously curating through time.</p>
  </div>
</section>

<section class="home-about">
  <div class="container home-about-inner">
    <div>
      <br>
      <h2>A little about the person behind this space</h2>
    </div>
    <div>
      <a class="home-button" href="/origin-of-signal/about/"> read more here ☘</a>
    </div>
  </div>
</section>
</BaseLayout>

<style>
  :global(main:has(.home-hero)) {
    padding-top: 0;
  }

  .home-hero {
    min-height: 90svh;
    display: flex;
    align-items: center;
    color: rgb(244 239 250 / 88%);
    background:
      linear-gradient(90deg, rgb(12 17 35 / 65%), rgb(12 17 35 / 12%)),
      url('/images/grainy-blue-night.jpg') center 45% / cover no-repeat;
  }

  .home-hero-content {
    padding-block: 10rem 6rem;
  }

  .home-hero h1 {
    max-width: 12ch;
    font-size: clamp(3.5rem, 8vw, 7rem);
    line-height: 1;
  }

  .home-hero h2 {
    max-width: 34ch;
    margin-top: 1.5rem;
    font-size: clamp(1.3rem, 2.5vw, 2rem);
    font-weight: 400;
    line-height: 1.35;
  }

  .home-hero p {
    max-width: 42rem;
    margin-top: 2.5rem;
    font-size: clamp(1rem, 0.85rem + 0.7vw, 1.35rem);
    text-indent: 0;
  }

.home-button {
  display: table;
  margin: 2rem auto 0;
  padding: 0.35rem 0.7rem;
  border: 1px solid #b8d4e5;
  color: #ece9f2;
  text-decoration: none;
}
</style>
